{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "tools",
    "docs",
    "src/components/vendor/agent-prism/DetailsView",
    "src/components/vendor/agent-prism/TraceViewer",
    "src/components/vendor/agent-prism/TraceList",
    "src/components/vendor/agent-prism/Button.tsx",
    "src/components/vendor/agent-prism/CollapseAndExpandControls.tsx",
    "src/components/vendor/agent-prism/CollapsibleSection.tsx",
    "src/components/vendor/agent-prism/CopyButton.tsx",
    "src/components/vendor/agent-prism/ErrorCountBadge.tsx",
    "src/components/vendor/agent-prism/ErrorStatusCircle.tsx",
    "src/components/vendor/agent-prism/IconButton.tsx",
    "src/components/vendor/agent-prism/SearchInput.tsx",
    "src/components/vendor/agent-prism/TabSelector.tsx",
    "src/components/vendor/agent-prism/Tabs.tsx",
    "src/components/vendor/agent-prism/TextInput.tsx",
    "src/components/vendor/agent-prism/TimestampBadge.tsx"
  ]
}
