{
  "icons": {
    "16": "./gen-assets/icon16.plasmo.png",
    "32": "./gen-assets/icon32.plasmo.png",
    "48": "./gen-assets/icon48.plasmo.png",
    "64": "./gen-assets/icon64.plasmo.png",
    "128": "./gen-assets/icon128.plasmo.png"
  },
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "./gen-assets/icon16.plasmo.png",
      "32": "./gen-assets/icon32.plasmo.png",
      "48": "./gen-assets/icon48.plasmo.png",
      "64": "./gen-assets/icon64.plasmo.png",
      "128": "./gen-assets/icon128.plasmo.png"
    },
    "default_popup": "./popup.html"
  },
  "version": "0.1.5",
  "author": "thealltour",
  "name": "하나투어 상품 추출기",
  "description": "하나투어 패키지 상세(/trp/pkg/*)에서 HanatourImportV1 JSON 추출 및 클립보드 복사",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.hanatour.com/trp/pkg/*"
      ],
      "js": [
        "..\\src\\contents\\hanatour.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.hanatour.com/*"
  ]
}
