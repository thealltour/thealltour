# Optional Pi-side config for scripts/verify-on-wsl.sh (copy next to the script
# as verify-on-wsl.env, or use ~/.env.verify-wsl / repo .env.verify-wsl).
# Do not commit real hosts with secrets; Host aliases are preferred.

# SSH Host alias (see ~/.ssh/config) or user@host — never hardcode in the script.
HERMES_WSL_VERIFY_HOST=hermes-build-laptop

# Optional override of the remote verification entrypoint on WSL.
# Default: $HOME/hermes-tools/scripts/verify-from-pi.sh
# HERMES_WSL_VERIFY_SCRIPT=/home/you/hermes-tools/scripts/verify-from-pi.sh
