# Copy into HERMES_BUILD_WORKSPACE as `.env.build-test` (never commit secrets).
# Pi `.env.local` must NOT be rsync'd. This file is for WSL compile/typecheck/build only.
#
# WARNING: verify-from-pi.sh sources this before vitest as well as next build.
# Do NOT set NODE_ENV=production here — it breaks the test suite.

# Public / compile-time placeholders — fill as needed for your local Next build.
# next.config.ts does not hard-require secrets at build time; auth providers are lazy.
# Add NEXT_PUBLIC_* keys here if a page import fails without them.

NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-placeholder
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-placeholder
