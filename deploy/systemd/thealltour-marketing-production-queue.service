[Unit]
Description=TheAllTour Marketing Production Queue Worker (one-shot)
Documentation=docs/hermes/marketing/agenda-production-queue-worker.md
After=network-online.target thealltour-internal.service
Wants=network-online.target

[Service]
Type=oneshot
User=ysh
Group=ysh
WorkingDirectory=/home/ysh/thealltour
Environment=NODE_ENV=production
# Include ~/.local/bin so `hermes` CLI resolves under systemd (ENOENT without it).
Environment=PATH=/home/ysh/.local/bin:/home/ysh/.hermes/node/bin:/usr/bin:/bin
Environment=HERMES_HOME=/home/ysh/.hermes
# Resolve the Hermes CLI explicitly instead of depending on PATH lookup.
Environment=HERMES_BIN=/home/ysh/.local/bin/hermes
# Keep research + tracing flags identical to the other marketing units so both
# cron entry points report the same environment (see marketingCronEnvironment.ts).
Environment=RESEARCH_COLLECTION_ENABLED=true
Environment=MARKETING_TRACE_ENABLED=true
# Secrets come from WorkingDirectory/.env.local — do not embed in this unit.
ExecStart=/home/ysh/.hermes/node/bin/npx tsx scripts/process-marketing-production-queue.ts --max-batch 3
# Prevent overlapping executions when a previous run is still active.
# Prefer timer AccuracySec + Persistent=false; also use systemd locking via RemainAfterExit=no.
Nice=10
# Per-candidate worst case grew with the 300s Hermes timeout + bounded retries.
TimeoutStartSec=3600
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
