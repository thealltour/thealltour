{
  "name": "theall",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --preset=perf --form-factor=mobile --throttling.cpuSlowdownMultiplier=4 --chrome-flags=\"--headless\"",
    "lighthouse:desktop": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --preset=perf --form-factor=desktop",
    "taxonomy:verify": "npx tsx scripts/verify-taxonomy-mapping.ts",
    "taxonomy:migrate": "npx tsx scripts/migrate-taxonomies.ts",
    "taxonomy:migrate:apply": "npx tsx scripts/migrate-taxonomies.ts --apply",
    "fix:imports": "node scripts/fix-component-imports.mjs",
    "favicon:build": "node scripts/build-favicon-ico.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
