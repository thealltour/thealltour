# Copy to the WSL build workspace as `.env.verify-local` (gitignored via `.env*`).
# Or export these in your shell before running scripts/verify-from-pi.sh.

# SSH host for hermes-pi (ssh config Host alias or user@host)
HERMES_PI_HOST=hermes-pi

# Absolute path to thealltour on Pi
HERMES_PI_PATH=/home/ysh/thealltour

# Absolute path to a WSL-only build workspace (NOT Pi, NOT $HOME itself)
# Example: /home/you/thealltour-verify
HERMES_BUILD_WORKSPACE=/home/REPLACE_ME/thealltour-verify
