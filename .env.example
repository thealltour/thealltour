# Aligo Kakao Alimtalk (카카오싱크 가입 알림톡)
# 자세한 계약: docs/aligo-alimtalk-relay.md

# Next → 가비아 VPS 알림톡 relay (기본: http://121.78.183.144:3000/send-alimtalk)
ALIGO_ALIMTALK_RELAY_URL=

# 템플릿 코드 (기본 UK_5796 = 「카카오싱크 회원가입」)
ALIGO_KAKAO_TPL_CODE_SIGNUP=UK_5796

# 알림톡 제목 (subject_1, 필수)
ALIGO_KAKAO_SIGNUP_SUBJECT=

# 승인 템플릿 전문과 동일(개행 포함). #{고객명}만 런타임 치환
ALIGO_KAKAO_SIGNUP_MESSAGE=

# 버튼 JSON 문자열 (button_1, 선택)
ALIGO_KAKAO_SIGNUP_BUTTON=

# 실패 시 대체문자 (Y일 때 FSUBJECT/FMESSAGE 필요)
ALIGO_KAKAO_SIGNUP_FAILOVER=N
ALIGO_KAKAO_SIGNUP_FSUBJECT=
ALIGO_KAKAO_SIGNUP_FMESSAGE=

# 알리고 테스트 모드 (Y = 실발송 없이 검증)
ALIGO_ALIMTALK_TEST_MODE=N

# Mini PC BGE-M3 embedding (server-only — never NEXT_PUBLIC_)
# EMBEDDING_PROVIDER=none | mini_pc
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_API_TOKEN=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_MS=30000

# AI Runtime (server-only — never NEXT_PUBLIC_)
# Provider keys may also live in HERMES_HOME/.env (hermes-pi); ensureRuntimeEnv fills missing keys.
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Places API (New) Text Search — server-only (Planner Reality Layer). Never NEXT_PUBLIC_.
# GOOGLE_MAPS_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# AI_RUNTIME_MARKETING_CRON_ENABLED=false
# AI_RUNTIME_SHARED_OBSERVABILITY_ENABLED=false

# Marketing Asset Store (server-only — never NEXT_PUBLIC_)
# Absolute filesystem path required by candidate asset export.
# Production target: /mnt/HDD2TB/marketing-assets
# Tests inject a temporary directory. Unset values fail closed (no repo writes).
# MARKETING_ASSET_ROOT=

# VoiceStudio TTS (server-only — never NEXT_PUBLIC_)
# Mini PC binds 127.0.0.1:3900 only. Do not change that binding from this repo.
# Variable names only — never commit a real key.
# VOICESTUDIO_BASE_URL=http://127.0.0.1:3900
# OMNIVOICE_API_KEY=
# VOICESTUDIO_TIMEOUT_MS=120000

# PortOne V2 (예약금·잔금 인증결제)
# 콘솔 결제연동 탭에서 Store ID / Channel Key / API Secret 확인
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 브라우저 fallback (선택). 서버 키가 우선이며, 없으면 공개키를 사용
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 웹훅 서명 검증용(선택). 없으면 서명 검사 스킵
PORTONE_WEBHOOK_SECRET=
# false면 prepare/결제 UI 일시 중단
PORTONE_ENABLED=true

# SPIKE: Hermes → Runtime OpenAI-compatible gateway (localhost/LAN only; never public)
# AI_RUNTIME_INFERENCE_GATEWAY_TOKEN=
# Optional: force first-candidate failure for ALL runtime-spike gateway requests (prefer alias theallcloud/auto-fallback-spike for scoped Desktop E2E)
# AI_RUNTIME_SPIKE_FORCE_FALLBACK=
