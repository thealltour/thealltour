{
  "name": "theall",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --preset=perf --form-factor=mobile --throttling.cpuSlowdownMultiplier=4 --chrome-flags=\"--headless\"",
    "lighthouse:desktop": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --preset=perf --form-factor=desktop",
    "taxonomy:verify": "npx tsx scripts/verify-taxonomy-mapping.ts",
    "taxonomy:migrate": "npx tsx scripts/migrate-taxonomies.ts",
    "taxonomy:migrate:apply": "npx tsx scripts/migrate-taxonomies.ts --apply",
    "fix:imports": "node scripts/fix-component-imports.mjs",
    "favicon:build": "node scripts/build-favicon-ico.mjs",
    "vapid:generate": "npx tsx scripts/generate-vapid-keys.ts",
    "airlines:import-logos": "npx tsx scripts/import-flightaware-logos.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "extensions:package": "node scripts/upload-extension-builds.mjs",
    "extensions:package:local": "node scripts/upload-extension-builds.mjs --skip-upload",
    "extensions:package:changed": "node scripts/upload-extension-builds.mjs --only-if-version-changed"
  },
