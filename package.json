    "@sentry/nextjs": "^10.49.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.21",
    "browser-image-compression": "^2.0.2",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-photo-view": "^1.2.7",
