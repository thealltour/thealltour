[Unit]
Description=TheAllTour Shortform Video Render Queue Worker (one-shot, Mini-PC)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ysh
Group=ysh
# Canonical checkout on Mini-PC (Option A). Do not mix into thealltour-ai-inference.
WorkingDirectory=/home/ysh/thealltour
Environment=NODE_ENV=production
# Mini-PC uses system Node (/usr/bin). Do not point ExecStart at Hermes-Pi ~/.hermes paths.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Fail-closed: set SHORTFORM_VIDEO_WORKER_ENABLED=true in .env.local only when SV-8 ready.
# Secrets come from WorkingDirectory/.env.local — do not embed in this unit.
ExecStart=/usr/bin/npx tsx scripts/process-shortform-video-render-queue.ts
# Below BGE-M3 / VoiceStudio priority so shared Mini-PC stays responsive.
Nice=15
# Must stay below DEFAULT_SHORTFORM_VIDEO_RENDER_LEASE_MS (45m) so reclaim cannot race a live worker.
TimeoutStartSec=1800
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
