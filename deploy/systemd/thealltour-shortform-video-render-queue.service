[Unit]
Description=TheAllTour Shortform Video Render Queue Worker (one-shot, Mini-PC)
Documentation=docs/hermes/marketing/shortform-video-worker-v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ysh
Group=ysh
# Canonical checkout on Mini-PC (Option A). Do not mix into thealltour-ai-inference.
WorkingDirectory=/home/ysh/thealltour
Environment=NODE_ENV=production
Environment=PATH=/home/ysh/.local/bin:/home/ysh/.hermes/node/bin:/usr/bin:/bin
Environment=HERMES_HOME=/home/ysh/.hermes
# Fail-closed: set SHORTFORM_VIDEO_WORKER_ENABLED=true in .env.local only when SV-8 ready.
# Secrets come from WorkingDirectory/.env.local — do not embed in this unit.
ExecStart=/home/ysh/.hermes/node/bin/npx tsx scripts/process-shortform-video-render-queue.ts
# Below BGE-M3 / VoiceStudio priority so shared Mini-PC stays responsive.
Nice=15
TimeoutStartSec=1800
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
